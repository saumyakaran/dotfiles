# Variables
set $mod Mod4
set $term kitty
set $menu rofi -show drun -show-icons

include ~/dotfiles/sway/colors

# Font
font pango:GeistMono Nerd Font 10

# HiDPI
output * scale 1.5

# Wallpaper (managed by theme/apply-theme.sh)
include ~/dotfiles/theme/sway-wallpaper

# Window appearance
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Gaps
gaps inner 8

# Window colors          border    bg        text      indicator child_border
client.focused           $base0D   $base00   $base05   $base0D   $base0D
client.focused_inactive  $base03   $base00   $base04   $base03   $base03
client.unfocused         $base02   $base00   $base03   $base02   $base02
client.urgent            $base08   $base00   $base05   $base08   $base08

# Input
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

input type:keyboard {
    xkb_options caps:escape
}

# Key bindings
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+space exec $menu
floating_modifier $mod normal
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec ~/dotfiles/rofi/powermenu.sh

# Navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+d focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym j resize grow height 10 px
    bindsym k resize shrink height 10 px
    bindsym l resize grow width 10 px
    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# App shortcuts
bindsym $mod+Shift+b exec brave-browser --password-store=basic --load-extension=$HOME/dotfiles/theme/brave-theme --new-window
bindsym $mod+Shift+w exec flatpak run com.stremio.Stremio
bindsym $mod+Shift+y exec brave-browser --password-store=basic --load-extension=$HOME/dotfiles/theme/brave-theme --new-window https://youtube.com
bindsym $mod+Shift+a exec brave-browser --password-store=basic --load-extension=$HOME/dotfiles/theme/brave-theme --new-window https://claude.ai

# Screen lock
bindsym $mod+Escape exec "ssh-add -D; swaylock"
for_window [class=".*"] inhibit_idle fullscreen
for_window [app_id=".*"] inhibit_idle fullscreen
# Caffeine toggle: $mod+c to inhibit/resume idle
for_window [title="^caffeine-inhibitor$"] floating enable, resize set 1 1, move scratchpad, inhibit_idle open
bindsym $mod+c exec ~/dotfiles/sway/caffeine.sh

exec swayidle -w \
    timeout 900 'ssh-add -D; swaylock' \
    timeout 930 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'ssh-add -D; swaylock'

# Screenshots
bindsym Print exec grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy -t image/png

# Keyboard brightness
bindsym F2 exec asusctl leds prev
bindsym F3 exec asusctl leds next

# Power profiles
bindsym $mod+F1 exec asusctl profile set Quiet && notify-send "Profile" "Quiet"
bindsym $mod+F2 exec asusctl profile set Balanced && notify-send "Profile" "Balanced"
bindsym $mod+F3 exec asusctl profile set Performance && notify-send "Profile" "Performance"

# Brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 5%- && ~/dotfiles/sway/notify-brightness.sh
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+ && ~/dotfiles/sway/notify-brightness.sh

# Volume
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && ~/dotfiles/sway/notify-vol.sh
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && ~/dotfiles/sway/notify-vol.sh
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && ~/dotfiles/sway/notify-vol.sh
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && notify-send -t 1000 -h string:x-canonical-private-synchronous:mic "Mic" "$(pactl get-source-mute @DEFAULT_SOURCE@)"

# Floating popups
for_window [app_id="floating-popup"] floating enable, resize set 1400 900, move position center

# Spotify: $mod+p to toggle show/hide (scratchpad minimize)
for_window [class="Spotify"] move scratchpad
bindsym $mod+p exec sh -c 'swaymsg "[class=Spotify] scratchpad show" || spotify'

# Theme switcher
bindsym $mod+t exec ~/dotfiles/theme/carousel.sh

# Autostart
exec ~/dotfiles/theme/apply-theme.sh $(cat ~/dotfiles/theme/current)
exec autotiling
exec mako
bar {
    swaybar_command waybar
}
