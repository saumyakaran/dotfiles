#!/usr/bin/env sh

source "$HOME/.config/sketchybar/colors.sh"
source "$HOME/.config/sketchybar/icons.sh"

ITEM_DIR="$HOME/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

FONT="SF Pro"
PADDINGS=3

# Transparent bar — islands provide their own backgrounds
sketchybar --bar     height=45                                         \
                     color=$TRANSPARENT                                \
                     shadow=off                                        \
                     position=top                                      \
                     sticky=on                                         \
                     padding_right=6                                   \
                     padding_left=6                                    \
                     corner_radius=0                                   \
                     y_offset=0                                        \
                     margin=0                                          \
                     blur_radius=0                                     \
                     border_width=0                                    \
                                                                       \
           --default updates=when_shown                                \
                     icon.font="$FONT:Bold:14.0"                       \
                     icon.color=$ICON_COLOR                            \
                     icon.padding_left=$PADDINGS                       \
                     icon.padding_right=$PADDINGS                      \
                     label.font="$FONT:Semibold:13.0"                  \
                     label.color=$LABEL_COLOR                          \
                     label.padding_left=$PADDINGS                      \
                     label.padding_right=$PADDINGS                     \
                     background.padding_right=$PADDINGS                \
                     background.padding_left=$PADDINGS                 \
                     popup.background.border_width=2                   \
                     popup.background.corner_radius=11                 \
                     popup.background.border_color=$POPUP_BORDER_COLOR \
                     popup.background.color=$POPUP_BACKGROUND_COLOR    \
                     popup.background.shadow.drawing=off

# Left island - Workspaces
source "$ITEM_DIR/spaces.sh"

# Right island - Date, Stats & Battery
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/memory.sh"
source "$ITEM_DIR/disk.sh"

# ── Island brackets ──────────────────────────────────────────────────
# Left island: workspaces
sketchybar --add bracket left_island '/space\..*/' \
           --set left_island \
                 background.color=$BAR_COLOR \
                 background.corner_radius=10 \
                 background.height=34 \
                 background.border_color=$SURFACE1 \
                 background.border_width=1 \
                 background.blur_radius=30 \
                 background.padding_left=8 \
                 background.padding_right=8

# Right island: datetime + stats + battery
sketchybar --add bracket right_island calendar cpu memory disk battery \
           --set right_island \
                 background.color=$BAR_COLOR \
                 background.corner_radius=10 \
                 background.height=34 \
                 background.border_color=$SURFACE1 \
                 background.border_width=1 \
                 background.blur_radius=30 \
                 background.padding_left=8 \
                 background.padding_right=8

############## FINALIZING THE SETUP ##############
sketchybar --update

echo "sketchybar configuration loaded.."
